# ====================================================================
# Employee Payroll Management System - Environment Configuration
# ====================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payroll_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Fallback Settings
# If set to true, the application will fallback to local embedded database if MySQL is unreachable
DB_ALLOW_EMBEDDED_FALLBACK=true

# Application Settings
APP_NAME=Employee Payroll Management System
APP_COMPANY=PayrollCorp Enterprise Solutions Pvt. Ltd.
APP_CURRENCY_SYMBOL=₹
APP_TAX_YEAR=2026-2027
